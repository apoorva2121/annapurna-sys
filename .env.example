# Copy to .env for local development. .env is gitignored and must never be committed.
# Settings are validated at startup (app/core/config.py) — a missing or bad value fails the boot
# loudly rather than surfacing as a mystery 500 later.

ENV=local                 # local | staging | production
DEBUG=true                # MUST be false outside local; boot fails otherwise
LOG_LEVEL=INFO

# Postgres. The compose file provides this database; override for a managed instance.
DATABASE_URL=postgresql+asyncpg://restaurant:restaurant@db:5432/restaurant_os

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Optional. Left blank until the Sentry account exists; error reporting is simply off when unset.
SENTRY_DSN=
