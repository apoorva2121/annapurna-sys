# Copy to .env for local development. .env is gitignored and must never be committed.
# Settings are validated at startup (app/core/config.py) — a missing or bad value fails the boot
# loudly rather than surfacing as a mystery 500 later.

ENV=local                 # local | staging | production
DEBUG=true                # MUST be false outside local; boot fails otherwise
LOG_LEVEL=INFO

# Postgres. The compose file provides this database; override for a managed instance.
DATABASE_URL=postgresql+asyncpg://restaurant:restaurant@db:5432/restaurant_os

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Optional. Left blank until the Sentry account exists; error reporting is simply off when unset.
SENTRY_DSN=

# --------------------------------------------------------------------------- auth (M01)
# Signs every access token. Left unset locally, where a known development default applies.
# Staging and production MUST set their own — the boot fails otherwise, because the default is
# committed to this repository and anyone who can read it could mint an owner token.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# Access tokens are short-lived because they cannot be revoked, only outlived. Anything that must
# take effect at once — deactivation, a role change, a password change — is enforced against the
# session row when the token is refreshed, so this is the worst-case window rather than the norm.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Argon2id cost. Raise until a login takes ~200-300ms on the target hardware and no longer: these
# are a trade between resisting an offline attack on a stolen dump and making a waiter wait.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# Five failures, then a wait. An owner or admin can clear a lock instantly, because at 7pm on a
# Saturday "wait fifteen minutes" means one fewer person taking orders.
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
