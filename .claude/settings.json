{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/scripts/hook_validate.py\"",
            "timeout": 60,
            "statusMessage": "Validating docs and seed data"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python scripts/audit_docs.py)",
      "Bash(python scripts/hook_validate.py)",
      "Bash(python seed/validate.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)"
    ]
  }
}
