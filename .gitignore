# Personal working files kept in the working copy but never committed (finding D9).
/Apoorva-Tasks.xlsx

# Microsoft Office lock files. Created while a document is open, deleted when it closes — they are
# never content, and one was committed by accident in M02.
~$*

# CLAUDE.md tells you to run the gate as `make check > check.log 2>&1; echo $?`, because reading
# the exit code is the only way to know it passed. That leaves this file behind every time.
/check.log

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# graft (owner decision 2026-09-14): wired into this working copy only. Its hooks live in the
# untracked local settings, so a clone without graft installed is not affected.
/.claude/settings.local.json
/.claude/helpers/graft-*.cjs
/.claude/skills/graft/
/.mcp.json

# The deploy image is built with the frontend bundle copied here (R4 one origin); see
# .github/workflows/deploy-staging.yml. Never committed - it is a build output.
backend/static/

# Credential scratch files. env.txt was a real near-miss on 2026-09-17: Neon hands out a
# PGUSER=/PGPASSWORD= snippet, it landed in the repo root untracked and un-ignored, and one
# `git add .` would have put a live database password into history - where gitleaks scans for it
# precisely because removing it in a later commit does not remove it.
env.txt
*.env.txt
env.local
secrets.txt

# Build output: the seed YAML copied into the image build context by CI (see
# .github/workflows/deploy-staging.yml). The source of truth is seed/ at the repository root.
backend/seed-data/

# The generated manual-test workbook. Deliberately NOT committed: the owner fills in Result,
# Notes and the Bugs sheet, and a regenerated copy would silently overwrite a completed pass.
# Rebuild it with scripts/build_manual_test_workbook.py; docs/manual-tests/*.md is the source.
Restaurant-OS-manual-tests.xlsx
